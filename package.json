{
  "name": "privalint",
  "version": "0.1.0",
  "description": "Lint your website for GDPR problems: trackers before consent and after reject, Google Fonts, embeds, missing Impressum. Real browser, CLI and GitHub Action.",
  "type": "module",
  "bin": {
    "privalint": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "demo": "npm run build && node scripts/render-demo.mjs"
  },
  "keywords": [
    "gdpr",
    "dsgvo",
    "privacy",
    "cookies",
    "consent",
    "tracker",
    "google-fonts",
    "impressum",
    "lint",
    "playwright",
    "github-action"
  ],
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jexcellence/privalint.git"
  },
  "homepage": "https://github.com/jexcellence/privalint#readme",
  "bugs": "https://github.com/jexcellence/privalint/issues"
}
